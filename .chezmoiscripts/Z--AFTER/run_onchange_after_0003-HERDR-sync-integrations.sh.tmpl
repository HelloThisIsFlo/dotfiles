{{- $herdrVersion := output "/bin/sh" "-c" `"$1" current herdr 2>/dev/null || printf '%s\n' 'not-installed'` "herdr-version" .mise_bin | trim -}}
#!/bin/bash
# Ensure integrations for herdr {{ $herdrVersion }}
# Integration inventory: .chezmoidata/agent-integrations.yaml
set -euo pipefail

mise_bin="{{ .mise_bin }}"
herdr_bin="$("$mise_bin" which herdr)"

{{- range $agent, $integrations := .agent_integrations }}
{{- if has "herdr" $integrations }}
"$herdr_bin" integration install {{ $agent | quote }}
{{- end }}
{{- end }}
