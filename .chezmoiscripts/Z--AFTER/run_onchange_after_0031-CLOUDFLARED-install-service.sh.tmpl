{{- if eq .host_universe "TheMac" -}}
#!/bin/bash

# Load or refresh TheMac's chezmoi-managed cloudflared LaunchAgent.
#
# - Gated to TheMac (see {{`{{ if ... }}`}} above).
# - Ordered after 0030-CLOUDFLARED-sync-themac-routes when both scripts are scheduled.
# - Re-runs when the plist, config, or tunnel credential changes.
# - Homebrew owns cloudflared updates; the plist disables cloudflared self-updates.
#
# Plist source hash: {{ include "private_Library/LaunchAgents/com.cloudflare.cloudflared.plist.tmpl" | sha256sum }}
# Config source hash: {{ include "private_dot_cloudflared/config-themac.yml.tmpl" | sha256sum }}
# Credential source hash: {{ include "private_dot_cloudflared/private_readonly_a57f23b6-310d-40bd-b061-e62ecfee83f3.json.tmpl" | sha256sum }}

set -euo pipefail

CONFIG="$HOME/.cloudflared/config.yml"
CREDENTIAL="$HOME/.cloudflared/a57f23b6-310d-40bd-b061-e62ecfee83f3.json"
PLIST="$HOME/Library/LaunchAgents/com.cloudflare.cloudflared.plist"
LABEL="com.cloudflare.cloudflared"
USER_ID="$(id -u)"
LAUNCH_DOMAIN="gui/$USER_ID"
SERVICE_TARGET="$LAUNCH_DOMAIN/$LABEL"
ERROR_LOG="$HOME/Library/Logs/com.cloudflare.cloudflared.err.log"

[ -f "$PLIST" ] \
  || { echo "cloudflared service load failed: $PLIST is missing"; exit 1; }
[ -f "$CONFIG" ] \
  || { echo "cloudflared service load failed: $CONFIG is missing"; exit 1; }
[ -r "$CREDENTIAL" ] \
  || { echo "cloudflared service load failed: $CREDENTIAL is missing or unreadable"; exit 1; }

plutil -lint "$PLIST" >/dev/null
CLOUDFLARED="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "$PLIST")"
[ -x "$CLOUDFLARED" ] \
  || { echo "cloudflared service load failed: $CLOUDFLARED is missing or not executable"; exit 1; }

"$CLOUDFLARED" tunnel --config "$CONFIG" ingress validate

if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
  echo "→ Removing the existing cloudflared LaunchAgent definition"
  launchctl bootout "$SERVICE_TARGET"
fi

echo "→ Loading the chezmoi-managed cloudflared LaunchAgent"
if ! launchctl bootstrap "$LAUNCH_DOMAIN" "$PLIST"; then
  echo "→ Launchd is still releasing the previous job; retrying in one second"
  sleep 1
  launchctl bootstrap "$LAUNCH_DOMAIN" "$PLIST"
fi
PID="$(launchctl kickstart -kp "$SERVICE_TARGET")"

case "$PID" in
  ''|*[!0-9]*)
    echo "cloudflared service load failed: launchctl returned an invalid PID: $PID"
    exit 1
    ;;
esac

for _ in 1 2 3 4 5; do
  sleep 1
  if ! kill -0 "$PID" 2>/dev/null; then
    echo "cloudflared service load failed: process $PID exited during startup"
    [ ! -f "$ERROR_LOG" ] || tail -n 20 "$ERROR_LOG" >&2
    exit 1
  fi
done

echo "✓ cloudflared user LaunchAgent is running as PID $PID"
{{ end -}}
